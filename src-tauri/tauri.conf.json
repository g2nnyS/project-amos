{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Amos Console",
  "version": "0.1.0",
  "identifier": "dev.amos.console",
  "build": {
    "beforeDevCommand": "npm run console:serve",
    "beforeBuildCommand": "npm run build && npm run tauri:prepare",
    "devUrl": "http://localhost:3000",
    "frontendDist": "../dist/console"
  },
  "bundle": {
    "active": true,
    "targets": ["appimage", "nsis", "dmg"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": ["binaries/node"],
    "resources": {
      "../dist/": "app/dist/",
      "../constraints/": "app/constraints/",
      "../guidance/": "app/guidance/",
      ".runtime/package.json": "app/package.json",
      ".runtime/node_modules/": "app/node_modules/"
    },
    "macOS": {
      "signingIdentity": "-",
      "hardenedRuntime": true,
      "entitlements": "entitlements.plist"
    },
    "linux": {
      "appimage": {
        "bundleMediaFramework": false
      }
    }
  },
  "app": {
    "windows": [
      {
        "title": "Amos 控制台",
        "width": 1440,
        "height": 960,
        "minWidth": 1024,
        "minHeight": 680,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  }
}
