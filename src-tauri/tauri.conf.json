{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Amos Console",
  "version": "0.1.0",
  "identifier": "dev.amos.console",
  "build": {
    "beforeDevCommand": "npm run console:serve",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:3000",
    "frontendDist": "../dist/console"
  },
  "bundle": {
    "active": true,
    "targets": ["appimage", "nsis", "dmg"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "../dist/**/*",
      "../constraints/**/*",
      "../guidance/**/*"
    ],
    "linux": {
      "appimage": {
        "bundleMediaFramework": false
      }
    }
  },
  "app": {
    "windows": [
      {
        "title": "Amos 控制台",
        "width": 1440,
        "height": 960,
        "minWidth": 1024,
        "minHeight": 680,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  }
}
