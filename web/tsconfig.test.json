{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022", "DOM"],
    "strict": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "outDir": ".test-dist",
    "rootDir": "..",
    "rewriteRelativeImportExtensions": true,
    "noEmitOnError": true,
    "declaration": false,
    "sourceMap": false,
    "types": ["node"],
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": [
    "src/types/**/*.ts",
    "src/data/**/*.ts",
    "src/lib/**/*.ts",
    "src/stores/**/*.ts",
    "src/composables/**/*.ts",
    "tests/**/*.ts"
  ]
}
