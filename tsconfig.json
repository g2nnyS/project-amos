{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "esModuleInterop": true,
    "types": [
      "node"
    ],
    "skipLibCheck": true
  },
  "include": [
    "activation/**/*.ts",
    "adapters/**/*.ts",
    "catalog/**/*.ts",
    "check/**/*.ts",
    "control-plane/**/*.ts",
    "decision/**/*.ts",
    "engine/**/*.ts",
    "guidance/**/*.ts",
    "host/**/*.ts",
    "injector/**/*.ts",
    "managed/**/*.ts",
    "review/**/*.ts",
    "rollout/**/*.ts",
    "storage/**/*.ts",
    "supervisor/**/*.ts",
    "workflow/**/*.ts"
  ],
  "exclude": [
    "dist",
    "node_modules"
  ]
}
