{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "esModuleInterop": true,
    "types": ["node"],
    "skipLibCheck": true
  },
  "include": ["engine/**/*.ts", "adapters/**/*.ts", "storage/**/*.ts", "decision/**/*.ts", "supervisor/**/*.ts", "guidance/**/*.ts", "injector/**/*.ts", "activation/**/*.ts", "catalog/**/*.ts", "workflow/**/*.ts", "host/**/*.ts", "review/**/*.ts", "check/**/*.ts", "rollout/**/*.ts", "governance/**/*.ts", "managed/**/*.ts"],
  "exclude": ["dist", "node_modules"]
}
