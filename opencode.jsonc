{
  "$schema": "https://opencode.ai/config.json",
  "plugins": [
    {
      "package": "./dist/adapters/opencode-v2",
      "options": {
        "mode": "log-only",
        "rulesPath": "./constraints/rules.yaml",
        "schemaPath": "./constraints/schema.json",
        "logPath": "./spike/logs/opencode.jsonl",
        "workflowGate": {
          "enabled": true,
          "guidance": true,
          "shellGate": true,
          "completionReview": true,
          "jevConfigPath": "./decision/jev.local.json"
        }
      }
    }
  ]
}
